    "directory:sync:paris": "SYNC_SCOPE=paris bun scripts/import-schools.ts",
    "directory:sync:france": "SYNC_SCOPE=france bun scripts/import-schools.ts",
    "prepare": "husky"
  },
  "dependencies": {
